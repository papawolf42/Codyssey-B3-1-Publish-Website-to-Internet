// 설명용 JSONC. AWS 정책 편집기에는 주석 없는 b3-1-ec2-seoul-policy.json을 사용하세요.
// 근거: ../../instruction.md의 §4 기능 요구 사항, §7 제약 사항, §8 결과 예시.
// 과제는 API 이름 목록을 지정하지 않습니다. 주석은 요구 문구와 그 구현 방법을 구분합니다.
// 36개 = 조회 13 + 네트워크 설정 9 + 네트워크 정리 8 + 키 2 + 실행 1 + 컴퓨트 정리 2 + 태그 1.
// 절대 최소 또는 AWS 동작 검증 완료 정책이 아닙니다. 일부는 선택 방식/콘솔 편의 권한입니다.
// 모든 Allow는 서울 리전에 한정. 기존 다른 정책의 허용을 취소하는 Deny는 아닙니다.
// ARN ID의 * 때문에 같은 계정·서울 리전의 기존 해당 유형 리소스도 변경/삭제할 수 있습니다.
// 인스턴스 1대·micro·EBS 용량·비용·SSH 소스 IP는 이 정책으로 강제하지 않습니다.
// 현재 IAM 사용자/Role 콘솔 접근 방식과 서울 리전 사용 가능 여부도 별도 확인 대상입니다.
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "B3ReadSeoul", // 콘솔 조회 기본안 13개. 명세가 이 13개 API를 모두 필수로 지정한 것은 아님.
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs", // [콘솔 조회] §4 네트워크 구성: "VPC 1개를 생성한다." → 생성한 VPC 확인. 이 조회 API 자체가 명세에 지정된 것은 아님.
        "ec2:DescribeSubnets", // [콘솔 조회] §4 네트워크 구성: "Public Subnet 1개를 생성한다." → 서브넷·VPC 연결 확인.
        "ec2:DescribeInternetGateways", // [콘솔 조회] §4 네트워크 구성: "Internet Gateway를 VPC에 연결한다." → 연결 상태 확인.
        "ec2:DescribeRouteTables", // [콘솔 조회] §4 네트워크 구성: "Public Subnet의 Route Table에 `0.0.0.0/0` → Internet Gateway 경로가 존재해야 한다." → 경로·연결 확인.
        "ec2:DescribeSecurityGroups", // [콘솔 조회] §4 접근 제어: "Security Group 인바운드는 원칙적으로 필요한 포트만 허용한다." → 실제 규칙 확인.
        "ec2:DescribeAvailabilityZones", // [콘솔 조회/방식 선택] §4 Public Subnet 생성의 가용 영역 선택을 보조. 명세에 이 API나 특정 가용 영역은 지정되지 않음.
        "ec2:DescribeImages", // [콘솔 조회/방식 선택] §7 실행 환경: "OS: Ubuntu LTS 또는 Amazon Linux 계열 중 택1" → AMI 선택을 보조.
        "ec2:DescribeInstanceTypes", // [콘솔 조회/방식 선택] §7 실행 환경: "인스턴스: 프리티어 대상 micro 급 인스턴스 1대(예: t2.micro 또는 t3.micro 중 택1)" → 사양 선택 보조. 무료 사용을 보장하지 않음.
        "ec2:DescribeKeyPairs", // [콘솔 조회/방식 선택] §7 실행 환경: "키페어: 1개 생성 후 안전하게 보관(재발급 불가 전제)" → 생성한 키 선택·삭제 확인.
        "ec2:DescribeInstances", // [콘솔 조회] §4 EC2 1대 생성 및 외부 접속 검증 → 인스턴스 상태·퍼블릭 IP 확인. API명은 명세에 없음.
        "ec2:DescribeInstanceStatus", // [콘솔 조회/보조] §4 "웹 서버(Nginx 등)를 설치하고 실행 상태여야 한다."의 기반인 EC2 상태 확인. 이 API는 웹 서버 실행 상태나 HTTP 200 자체를 검증하지 않음.
        "ec2:DescribeVolumes", // [콘솔 조회] §4 운영 안정성: "최소한 다음 항목은 정리 완료를 확인해야 한다: EC2, EBS(볼륨), Elastic IP, Internet Gateway, VPC" → 잔여 EBS 확인.
        "ec2:DescribeNetworkInterfaces" // [콘솔 조회/보조] §4 네트워크 구성 및 §7 리소스 정리 → EC2 연결·삭제 의존성 조사. ENI 조회 자체가 명세에 지정된 필수 작업은 아님.
      ],
      "Resource": "*", // 조회 API의 리소스별 ARN 제한 미지원. 작업 목록과 서울 리전 조건으로 범위 제한.
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3NetworkSetup", // 선택한 별도 Route Table·새 보안 그룹 방식의 생성/설정 9개.
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc", // [요구 구현] §4 네트워크 구성: "VPC 1개를 생성한다."
        "ec2:CreateSubnet", // [요구 구현] §4 네트워크 구성: "Public Subnet 1개를 생성한다." 생성만으로 Public이 되는 것은 아님.
        "ec2:CreateInternetGateway", // [요구 구현에 필요한 생성] §4 "Internet Gateway를 VPC에 연결한다." → 연결할 IGW를 새로 만드는 이번 구성에 필요.
        "ec2:AttachInternetGateway", // [요구 구현] §4 네트워크 구성: "Internet Gateway를 VPC에 연결한다."
        "ec2:CreateRouteTable", // [방식 선택] §4 Public Subnet의 기본 경로 요구 → 기본 테이블 재사용 대신 별도 테이블을 만들기로 선택했기 때문에 포함.
        "ec2:AssociateRouteTable", // [방식 선택] §4 Public Subnet의 Route Table 요구 → 별도 생성한 테이블을 서브넷에 연결하는 방식에 필요.
        "ec2:CreateRoute", // [요구 구현] §4 "Public Subnet의 Route Table에 `0.0.0.0/0` → Internet Gateway 경로가 존재해야 한다."
        "ec2:CreateSecurityGroup", // [요구 구현에 필요한 생성] §4 접근 제어(보안 그룹) → 기존 그룹 재사용 대신 실습용 그룹을 새로 만드는 구성에 필요.
        "ec2:AuthorizeSecurityGroupIngress" // [요구 구현] §4 "HTTP(80)는 0.0.0.0/0에서 접근 가능해야 한다." 및 "SSH(22)는 학습자 개인 IP(또는 지정된 IP 대역)에서만 접근 가능해야 한다." 이 IAM 허용 자체가 포트·IP 제한을 강제하지는 않음.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:067518846638:vpc/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:subnet/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:route-table/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3NetworkCleanup", // 직접 만든 네트워크를 역순으로 정리하는 8개. 정리 절차에 따라 일부는 생략 가능.
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteSecurityGroup", // [선택 구성의 정리] §7 "실습 종료 후 생성한 리소스는 모두 종료/삭제하여 과금이 발생하지 않도록 한다." → 직접 만든 그룹 삭제.
        "ec2:DeleteRoute", // [정리 방식 선택] §7 생성 리소스 정리 → 기본 경로를 먼저 지우는 역순 정리 방식. 테이블 삭제로 함께 제거할 수도 있어 모든 경로에서 필수는 아님.
        "ec2:DisassociateRouteTable", // [선택 구성의 정리] §7 생성 리소스 정리 → 별도 테이블 삭제 전 서브넷 연결 해제.
        "ec2:DeleteRouteTable", // [선택 구성의 정리] §7 생성 리소스 정리 → 직접 만든 별도 테이블 삭제.
        "ec2:DetachInternetGateway", // [정리 선행 작업] §4 운영 안정성의 IGW 정리 및 §8 예시 "Internet Gateway Detach 및 삭제 확인" → 삭제 전에 VPC에서 분리.
        "ec2:DeleteInternetGateway", // [요구 구현/정리] §4 운영 안정성의 Internet Gateway 정리 완료 확인 → 분리 후 삭제.
        "ec2:DeleteSubnet", // [선택 구성의 정리] §7 생성한 리소스 모두 정리 및 §8 "VPC 및 Subnet/Route Table 삭제 확인" → 서브넷 삭제.
        "ec2:DeleteVpc" // [요구 구현/정리] §4 운영 안정성의 VPC 정리 완료 확인 → 의존 리소스 정리 후 삭제.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:067518846638:vpc/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:subnet/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:route-table/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3SshKeyLifecycle", // 새 SSH 키페어를 AWS에서 만드는 선택 방식과 그 정리 2개.
      "Effect": "Allow",
      "Action": [
        "ec2:CreateKeyPair", // [방식 선택/권장 가이드] §7 "키페어: 1개 생성 후 안전하게 보관(재발급 불가 전제)" 및 §4 SSH 접속 요구 → AWS에서 새 키를 만드는 방식. API명은 명세에 없음.
        "ec2:DeleteKeyPair" // [선택 구성의 정리] §7 생성한 리소스 모두 정리 → AWS 등록 키 삭제. 로컬 개인 키나 서버 authorized_keys는 지워지지 않음.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:067518846638:key-pair/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3LaunchInstance", // EC2 실행 1개. RunInstances는 여러 리소스를 함께 검사함.
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances" // [요구 구현] §4 컴퓨트: "Public Subnet에 EC2 인스턴스 1대를 생성한다." 이 정책은 대수·타입·디스크 용량을 강제하지 않음.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2::image/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:instance/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:network-interface/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:subnet/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:volume/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:key-pair/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3ComputeCleanup", // EC2 종료와 잔여 EBS 삭제 2개.
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances", // [요구 구현/정리] §7 "EC2(종료 상태 확인)" → 중지가 아니라 종료. 생성한 인스턴스 정리.
        "ec2:DeleteVolume" // [조건부 정리] §7 "EBS Volumes(미사용 볼륨 포함 삭제 확인)" → 종료 후 볼륨이 남을 때 필요. 자동 삭제됐다면 실행 불필요.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:067518846638:instance/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        }
      }
    },
    {
      "Sid": "B3ResourceLabels", // Name/Project 태그 부착을 선택했기 때문에 포함한 1개. 실습 리소스 격리를 강제하는 태그 정책은 아님.
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags" // [방식 선택] §4 IAM 최소권한의 예: "예: 생성·조회·태그·연결 등 실습에 필요한 작업 중심". 모든 예시 API가 필수라는 뜻은 아님. Name/Project로 식별하기로 선택하여 포함.
      ],
      "Resource": [
        "arn:aws:ec2:ap-northeast-2:067518846638:vpc/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:subnet/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:internet-gateway/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:route-table/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:security-group-rule/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:instance/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:volume/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:network-interface/*",
        "arn:aws:ec2:ap-northeast-2:067518846638:key-pair/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "ap-northeast-2" // §7: "모든 리소스는 서울 리전(`ap-northeast-2`)에 생성한다."
        },
        "ForAllValues:StringEquals": { // 아래 태그 키만 허용. 태그 값이나 Project 태그 부착을 강제하지는 않음.
          "aws:TagKeys": [
            "Name",
            "Project"
          ]
        },
        "Null": {
          "aws:TagKeys": "false"
        }
      }
    }
  ]
}
