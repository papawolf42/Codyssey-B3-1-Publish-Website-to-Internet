    {
      "type": "text",
      "id": "learning-status-14",
      "x": 3156,
      "y": 1364,
      "width": 644,
      "height": 24,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
