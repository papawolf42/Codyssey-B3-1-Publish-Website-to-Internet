    {
      "type": "text",
      "id": "learning-status-7",
      "x": 2452,
      "y": 780,
      "width": 644,
      "height": 24,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": "learning-frame",
      "roundness": null,
      "seed": 1078,
      "version": 1,
      "versionNonce": 1079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792372357803,
      "link": null,
      "locked": false,
      "text": "실습 확인 + 개념 정리",
      "originalText": "실습 확인 + 개념 정리",
      "fontSize": 15,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "learning-body-7",
      "x": 2452,
      "y": 817,
      "width": 644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": "learning-frame",
      "roundness": null,
      "seed": 1080,
      "version": 2,
      "versionNonce": 1081,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792372357803,
      "link": null,
      "locked": false,
      "text": "이름에 Public을 붙이는 것만으로 퍼블릭이 되지 않는다.\n서브넷에 적용된 라우팅에 IGW 경로가 있어야 한다.\nEC2의 인터넷 통신에는 공인 IP·보안 규칙도 따로 필요하다.\n서브넷의 자동 IP 설정과 EC2의 공인 IP 설정은 구분한다.",
      "originalText": "이름에 Public을 붙이는 것만으로 퍼블릭이 되지 않는다.\n서브넷에 적용된 라우팅에 IGW 경로가 있어야 한다.\nEC2의 인터넷 통신에는 공인 IP·보안 규칙도 따로 필요하다.\n서브넷의 자동 IP 설정과 EC2의 공인 IP 설정은 구분한다.",
      "fontSize": 18,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
