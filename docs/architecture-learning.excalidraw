      "autoResize": true
    },
    {
      "type": "text",
      "id": "learning-body-11",
      "x": 3156,
      "y": 1109,
      "width": 644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": "learning-frame",
      "roundness": null,
      "seed": 1112,
      "version": 2,
      "versionNonce": 1113,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792372357803,
      "link": null,
      "locked": false,
      "text": "웹 공개용 HTTP TCP 80은 모든 IPv4에서 허용했다.\n관리용 SSH TCP 22는 내 공인 IP /32만 허용했다.\n/32는 IP 한 개 제한이지 로그인 사용자 인증이 아니다.\n같은 default 이름도 VPC가 다르면 다른 보안 그룹이다.",
      "originalText": "웹 공개용 HTTP TCP 80은 모든 IPv4에서 허용했다.\n관리용 SSH TCP 22는 내 공인 IP /32만 허용했다.\n/32는 IP 한 개 제한이지 로그인 사용자 인증이 아니다.\n같은 default 이름도 VPC가 다르면 다른 보안 그룹이다.",
      "fontSize": 18,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
