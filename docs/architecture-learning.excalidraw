      "text": "18 · 브라우저 Instance Connect",
      "originalText": "18 · 브라우저 Instance Connect",
      "fontSize": 22,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "learning-status-17",
      "x": 3156,
      "y": 1656,
      "width": 644,
      "height": 24,
      "angle": 0,
      "strokeColor": "#9a3412",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
      "frameId": "learning-frame",
