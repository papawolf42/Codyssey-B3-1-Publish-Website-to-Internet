      "updated": 1792372357804,
      "link": null,
      "locked": false,
      "text": "실습 확인 + 개념 정리",
      "originalText": "실습 확인 + 개념 정리",
      "fontSize": 15,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
