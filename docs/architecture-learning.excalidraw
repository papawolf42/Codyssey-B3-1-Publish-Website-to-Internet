      "text": "08 · Public Subnet의 조건",
      "originalText": "08 · Public Subnet의 조건",
      "fontSize": 22,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
