      "containerId": null,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "learning-body-19",
      "x": 2452,
      "y": 1985,
      "width": 644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0.5,
      "opacity": 100,
      "groupIds": [],
