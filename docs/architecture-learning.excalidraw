    },
    {
      "type": "text",
      "id": "learning-body-12",
      "x": 1748,
      "y": 1401,
      "width": 644,
      "height": 90,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
