      "updated": 1792372357805,
      "link": null,
      "locked": false,
      "text": "23 · 로컬 웹 터미널 ttyd",
      "originalText": "23 · 로컬 웹 터미널 ttyd",
      "fontSize": 22,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true
    },
    {
      "type": "text",
      "id": "learning-status-22",
      "x": 2452,
      "y": 2240,
      "width": 644,
      "height": 24,
      "angle": 0,
      "strokeColor": "#475569",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
