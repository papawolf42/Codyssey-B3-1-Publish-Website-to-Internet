      "updated": 1792372357803,
      "link": null,
      "locked": false,
      "text": "실습 확인",
      "originalText": "실습 확인",
      "fontSize": 15,
      "fontFamily": 2,
      "lineHeight": 1.25,
      "textAlign": "left",
      "verticalAlign": "top",
